# Copie este archivo como .env y complete sus propios valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Clave secreta de Django. Se lee del .env para no publicarla en el repositorio.
SECRET_KEY=escriba-aqui-una-clave-larga-y-aleatoria

# True muestra el detalle de los errores (solo para desarrollo).
DEBUG=True

# Direcciones desde las que se puede usar la API.
ALLOWED_HOSTS=localhost,127.0.0.1

# Conexión a MySQL (los mismos datos del script database/taller_mecanico_db.sql)
DB_NAME=taller_mecanico_db
DB_USER=taller_user
DB_PASSWORD=escriba-aqui-su-contrasena-local
DB_HOST=localhost
DB_PORT=3306
